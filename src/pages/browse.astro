---
import Layout from '../components/Layout.astro';
import { getAllBoards } from '../lib/boards.js';

const boards = getAllBoards();
const total = boards.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

function hash(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = ((h << 5) - h) + s.charCodeAt(i);
    h |= 0;
  }
  return Math.abs(h);
}

// 3 条绳子,每条 ~5-7 件物件(真画板 + 装饰)
const ROPES = 3;
const TOTAL = Math.max(15, boards.length * 3); // 至少 15 件让墙不空

// 把真画板均匀分布到三条绳子
const ropeItems = Array.from({ length: ROPES }, () => []);
boards.forEach((board, i) => {
  const ropeIdx = i % ROPES;
  ropeItems[ropeIdx].push({ kind: 'board', board });
});

// 把装饰物均匀填充到三条绳子,目标每条 ~5-7 件
const DECO_TYPES = ['photo', 'handwritten', 'watercolor', 'collage', 'botanical', 'tag-color'];
const TARGET_PER_ROPE = Math.max(5, Math.ceil(TOTAL / ROPES));
let decoSeed = 0;
for (let r = 0; r < ROPES; r++) {
  while (ropeItems[r].length < TARGET_PER_ROPE) {
    const h = hash(`deco-${r}-${decoSeed++}`);
    ropeItems[r].push({
      kind: 'deco',
      decoType: DECO_TYPES[h % DECO_TYPES.length],
      seed: h,
    });
  }
}

// 在每条绳子里 shuffle (deterministic) 让真画板和装饰交错
ropeItems.forEach((rope, r) => {
  const indices = rope.map((_, i) => i);
  // shuffle by sin-based pseudo-random per (r, i)
  indices.sort((a, b) => {
    const ha = Math.abs(Math.sin((r + 1) * 31 + a * 17) * 10000) % 1;
    const hb = Math.abs(Math.sin((r + 1) * 31 + b * 17) * 10000) % 1;
    return ha - hb;
  });
  ropeItems[r] = indices.map(i => rope[i]);
});

// 计算每个 item 的样式
const SHAPES = ['rect', 'rect', 'rect', 'rect', 'tag', 'note'];
const CLIPS = ['binder', 'binder', 'binder', 'binder', 'wood', 'wood', 'metal', 'pin'];

function styleForItem(item, ropeIdx, posIdx) {
  const key = item.kind === 'board' ? item.board.slug : `deco-${ropeIdx}-${posIdx}-${item.seed}`;
  const h = item.kind === 'board' ? hash(item.board.slug) : item.seed;

  return {
    rotate: (((h >> 8) % 80) / 10 - 4).toFixed(2),
    yOffset: ((h >> 4) % 30) - 15, // -15~15 px
    size: item.kind === 'board'
      ? ['m', 'm', 'l'][(h >> 12) % 3]
      : ['s', 's', 'm'][(h >> 14) % 3],
    shape: SHAPES[h % SHAPES.length],
    clip: CLIPS[(h >> 3) % CLIPS.length],
    clipOffset: (((h >> 5) % 30) - 15),
    enterDelay: (ropeIdx * 5 + posIdx) * 0.04,
  };
}

// 把 boards 序列化嵌入到页面,供 lightbox 展开使用
const boardsJson = JSON.stringify(boards).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
---
<Layout title="所有画板" noFooter>
  <div class="wall-bg"></div>

  <div class="wall-immersive">
    {/* 标题 */}
    <div class="wall-title">
      <p class="page-tagline serif">每个人都是自己人生路上的灯塔</p>
      <h1>所有人的画板</h1>
      <p class="title-meta">{total} 张真实留言挂在墙上 · 鼠标 ← → 拖或滚轮看更多</p>
    </div>

    {ropeItems.map((rope, ropeIdx) => (
      <section class="rope-lane" data-rope={ropeIdx}>
        <svg
          class="rope-line"
          viewBox="0 0 100 8"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d={`M0,2 Q30,${3 + ropeIdx * 0.4} 50,${2.5 + ropeIdx * 0.3} T100,2`}
            stroke="currentColor"
            stroke-width="0.42"
            fill="none"
            stroke-linecap="round"
          />
        </svg>
        <div class="rope-track" data-track={ropeIdx}>
          <div class="rope-spacer-start"></div>
          {rope.map((it, posIdx) => {
            const s = styleForItem(it, ropeIdx, posIdx);
            const itemStyle = `--rotate: ${s.rotate}deg; --y: ${s.yOffset}px; --clip-offset: ${s.clipOffset}%; --enter-delay: ${s.enterDelay}s;`;

            if (it.kind === 'board') {
              const board = it.board;
              const firstStranger = board.to_strangers[0] || board.to_self[0] || '';
              const tagList = (board.tags || []).slice(0, 2);
              return (
                <a
                  href={`${base}/boards/${board.slug}/`}
                  class={`hcard hcard-real hcard-${s.shape} hcard-size-${s.size}`}
                  data-theme={board.theme}
                  data-slug={board.slug}
                  style={itemStyle}
                  aria-label={`展开 ${board.name} 的画板`}
                >
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <span class="hcard-emoji" aria-hidden="true">{board.emoji}</span>
                  <h3 class="hcard-name">{board.name}</h3>
                  <p class="hcard-text">{firstStranger}</p>
                  {tagList.length > 0 && (
                    <p class="hcard-tags">{tagList.map((t) => `#${t}`).join('  ')}</p>
                  )}
                </a>
              );
            }

            // Deco items
            const dec = it.decoType;
            const seed = it.seed;
            const hue1 = seed % 360;
            const hue2 = (seed >> 8) % 360;
            const hue3 = (seed >> 16) % 360;
            const decClass = `hcard hcard-deco hcard-${dec} hcard-size-${s.size}`;

            if (dec === 'photo') {
              const w = s.size === 's' ? 160 : 190;
              const hImg = s.size === 's' ? 200 : 240;
              return (
                <div class={decClass} style={itemStyle} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <div class="photo-frame">
                    <img src={`https://picsum.photos/seed/bb-${seed}/${w}/${hImg}`} alt="" loading="lazy" />
                  </div>
                </div>
              );
            }
            if (dec === 'handwritten') {
              return (
                <div class={decClass} style={itemStyle} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg class="hw-lines" viewBox="0 0 100 70" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M8,10 Q18,7 32,9 T 58,10 T 88,9" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
                    <path d="M8,18 Q15,16 28,17 T 52,18 T 80,17" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
                    <path d="M8,26 Q20,24 42,26 T 78,25" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.5" stroke-linecap="round" />
                    <path d="M8,34 Q22,32 48,33 T 82,34" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
                    <path d="M8,42 Q18,40 35,41 T 65,42" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.45" stroke-linecap="round" />
                    <path d="M8,50 Q15,48 28,49 T 50,49" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.4" stroke-linecap="round" />
                  </svg>
                </div>
              );
            }
            if (dec === 'watercolor') {
              return (
                <div class={decClass} style={itemStyle} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg viewBox="0 0 100 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <ellipse cx="50" cy="42" rx="38" ry="28" fill={`hsl(${hue1}, 32%, 64%)`} opacity="0.55" />
                    <ellipse cx="46" cy="38" rx="30" ry="22" fill={`hsl(${hue1 + 20}, 38%, 70%)`} opacity="0.55" />
                    <ellipse cx="55" cy="45" rx="22" ry="16" fill={`hsl(${hue1 - 15}, 28%, 58%)`} opacity="0.6" />
                  </svg>
                </div>
              );
            }
            if (dec === 'collage') {
              return (
                <div class={decClass} style={itemStyle} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg viewBox="0 0 100 110" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <rect x="10" y="15" width="35" height="48" fill={`hsl(${hue1}, 45%, 62%)`} opacity="0.85" />
                    <circle cx="65" cy="35" r="22" fill={`hsl(${hue2}, 50%, 60%)`} opacity="0.85" />
                    <rect x="40" y="58" width="35" height="32" fill={`hsl(${hue3}, 42%, 68%)`} opacity="0.85" transform="rotate(8, 57, 74)" />
                  </svg>
                </div>
              );
            }
            if (dec === 'botanical') {
              return (
                <div class={decClass} style={itemStyle} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg viewBox="0 0 100 130" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <path d="M50,15 L50,115" stroke="#6e8254" stroke-width="0.8" opacity="0.7" />
                    <ellipse cx="50" cy="35" rx="14" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(-35, 50, 35)" />
                    <ellipse cx="50" cy="55" rx="13" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(35, 50, 55)" />
                    <ellipse cx="50" cy="75" rx="14" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(-30, 50, 75)" />
                    <ellipse cx="50" cy="95" rx="12" ry="5" fill="#86a96a" opacity="0.85" transform="rotate(28, 50, 95)" />
                  </svg>
                </div>
              );
            }
            if (dec === 'tag-color') {
              const fillHue = [220, 30, 150, 350][seed % 4];
              const fillSat = [40, 55, 35, 45][seed % 4];
              return (
                <div class={decClass} style={`${itemStyle} --tag-bg: hsl(${fillHue}, ${fillSat}%, 38%);`} aria-hidden="true">
                  <span class={`hcard-clip hcard-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M10,15 Q22,12 38,14 T 70,13 T 90,15" stroke="rgba(255,255,255,0.6)" stroke-width="0.5" fill="none" stroke-linecap="round" />
                    <path d="M10,25 Q22,22 38,24 T 70,23 T 85,25" stroke="rgba(255,255,255,0.55)" stroke-width="0.5" fill="none" stroke-linecap="round" />
                    <path d="M10,35 Q22,32 38,34 T 65,33" stroke="rgba(255,255,255,0.5)" stroke-width="0.5" fill="none" stroke-linecap="round" />
                    <path d="M10,45 Q20,42 35,44 T 60,45" stroke="rgba(255,255,255,0.45)" stroke-width="0.5" fill="none" stroke-linecap="round" />
                  </svg>
                </div>
              );
            }
            return null;
          })}
          <div class="rope-spacer-end"></div>
        </div>
      </section>
    ))}

    <a href={`${base}/create/`} class="wall-cta">
      <span class="wall-cta-line">这面墙还有地方</span>
      <span class="wall-cta-main">挂一张属于你的 →</span>
    </a>
  </div>

  {/* ─── Lightbox modal: 点击画框展开 ─── */}
  <div id="expand-overlay" hidden>
    <div class="expand-backdrop" data-close></div>
    <article class="expand-card" id="expand-card" role="dialog" aria-modal="true" aria-labelledby="expand-name">
      <button class="expand-close" data-close type="button" aria-label="关闭">✕</button>
      <div class="expand-inner" id="expand-inner">
        {/* 内容由 JS 动态填充 */}
      </div>
    </article>
  </div>

  <script type="application/json" id="boards-json" set:html={boardsJson} />

  <script is:inline>
    (function () {
      // ─── 1. 鼠标滚轮垂直 → 横向滚动 ───
      document.querySelectorAll('.rope-track').forEach((track) => {
        track.addEventListener(
          'wheel',
          (e) => {
            if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
              e.preventDefault();
              track.scrollLeft += e.deltaY;
            }
          },
          { passive: false }
        );
      });

      // ─── 2. Lightbox 展开 ───
      var boardsData = [];
      try {
        boardsData = JSON.parse(document.getElementById('boards-json').textContent);
      } catch (e) {
        console.error('parse boards-json failed', e);
      }
      var overlay = document.getElementById('expand-overlay');
      var inner = document.getElementById('expand-inner');
      var cardEl = document.getElementById('expand-card');
      var lastFocus = null;

      function esc(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function renderExpanded(board) {
        var parts = [];
        parts.push('<header class="ec-head">');
        parts.push('<div class="ec-emoji-wrap"><span class="ec-emoji">' + esc(board.emoji) + '</span></div>');
        parts.push('<h2 class="ec-name" id="expand-name">' + esc(board.name) + '</h2>');
        if (board.tags && board.tags.length) {
          parts.push('<div class="ec-tags">' + board.tags.map(function (t) {
            return '<span class="ec-tag">#' + esc(t) + '</span>';
          }).join('') + '</div>');
        }
        if (board.mood_today) {
          parts.push('<p class="ec-mood"><span class="ec-mood-label">写下这块板子那天的心情</span><span class="ec-mood-value">' + esc(board.mood_today) + '</span></p>');
        }
        parts.push('</header>');

        if (board.to_self && board.to_self.length) {
          parts.push('<section class="ec-block"><h3 class="ec-block-head">给自己</h3>');
          board.to_self.forEach(function (t) {
            parts.push('<blockquote class="ec-quote ec-self"><p>' + esc(t) + '</p></blockquote>');
          });
          parts.push('</section>');
        }

        if (board.image && board.image.src) {
          parts.push('<figure class="ec-image"><img src="' + esc(board.image.src) + '" alt="' + esc(board.image.alt || '') + '" loading="lazy"/>');
          if (board.image.alt) parts.push('<figcaption>' + esc(board.image.alt) + '</figcaption>');
          parts.push('</figure>');
        }

        if (board.to_strangers && board.to_strangers.length) {
          parts.push('<section class="ec-block"><h3 class="ec-block-head">给你 <span class="ec-block-sub">— 这个我永远不会认识, 但今天恰好走到这里的你</span></h3>');
          board.to_strangers.forEach(function (t) {
            parts.push('<blockquote class="ec-quote ec-stranger"><p>' + esc(t) + '</p></blockquote>');
          });
          parts.push('</section>');
        }

        if (board.song && board.song.url) {
          parts.push('<aside class="ec-song">');
          parts.push('<p class="ec-block-head">' + esc(board.name) + ' 留下的一首歌</p>');
          if (board.song.title) parts.push('<p class="ec-song-title">' + esc(board.song.title) + '</p>');
          if (board.song.why) parts.push('<blockquote class="ec-quote ec-stranger"><p>' + esc(board.song.why) + '</p></blockquote>');
          parts.push('<p class="ec-song-link"><a href="' + esc(board.song.url) + '" target="_blank" rel="noopener nofollow">在原平台听 →</a></p>');
          parts.push('</aside>');
        }

        if (board.link) {
          parts.push('<p class="ec-link"><a href="' + esc(board.link) + '" target="_blank" rel="noopener nofollow">' + esc(board.link) + ' →</a></p>');
        }

        parts.push('<footer class="ec-footer"><a href="/boards/' + esc(board.slug) + '/" class="ec-permalink">看完整页面 →</a></footer>');
        return parts.join('');
      }

      function open(slug) {
        var board = boardsData.find(function (b) { return b.slug === slug; });
        if (!board) return;
        lastFocus = document.activeElement;
        cardEl.dataset.theme = board.theme;
        inner.innerHTML = renderExpanded(board);
        cardEl.scrollTop = 0;
        overlay.hidden = false;
        document.body.classList.add('overlay-open');
        // trigger transition
        requestAnimationFrame(function () {
          overlay.classList.add('in');
          var closeBtn = overlay.querySelector('.expand-close');
          if (closeBtn) closeBtn.focus();
        });
      }

      function close() {
        overlay.classList.remove('in');
        document.body.classList.remove('overlay-open');
        setTimeout(function () {
          overlay.hidden = true;
          inner.innerHTML = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }, 320);
      }

      // 拦截真画板点击
      document.querySelectorAll('.hcard-real[data-slug]').forEach(function (card) {
        card.addEventListener('click', function (e) {
          e.preventDefault();
          open(card.getAttribute('data-slug'));
        });
      });

      // 关闭事件
      overlay.addEventListener('click', function (e) {
        if (e.target.dataset && e.target.dataset.close !== undefined) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !overlay.hidden) close();
      });
    })();
  </script>
</Layout>

<style>
  /* ─── 墙面背景 ────────────────────────────────────── */
  .wall-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: #ece4d1;
    background-image:
      radial-gradient(ellipse 100vw 80vh at 80% -10%, rgba(255, 244, 220, 0.95) 0%, transparent 55%),
      radial-gradient(ellipse 70vw 90vh at -10% 30%, rgba(225, 215, 195, 0.55) 0%, transparent 50%);
  }
  .wall-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 25%, rgba(255, 250, 235, 0.5) 32%, rgba(255, 250, 235, 0.5) 38%, transparent 45%),
      linear-gradient(115deg, transparent 55%, rgba(255, 250, 235, 0.32) 62%, transparent 70%);
    pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    .wall-bg { background: #1d1a14; background-image: none; }
  }

  /* ─── Wall 容器 ───────────────────────────────────── */
  .wall-immersive {
    position: relative;
    width: 100vw;
    height: calc(100vh - 70px);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 4.5rem 0 3.5rem;
  }

  /* ─── 标题 ─────────────────────────────────────── */
  .wall-title {
    position: absolute;
    top: 1.1rem;
    left: 1.75rem;
    z-index: 10;
    max-width: 30em;
    pointer-events: none;
  }
  .page-tagline {
    font-style: italic;
    color: #8a7553;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.3rem;
  }
  .wall-title h1 {
    font-size: 1.55rem;
    margin: 0 0 0.3rem;
    font-weight: 500;
    color: #3d2f18;
  }
  .title-meta {
    color: #6e5836;
    margin: 0;
    font-size: 0.78rem;
    font-family: var(--font-sans);
  }

  /* ─── 绳子 lane: 横向滚动 ────────────────────────── */
  .rope-lane {
    position: relative;
    flex: 1;
    min-height: 200px;
    max-height: 32%;
    /* 左右淡出 mask 提示有更多内容 */
    mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
  }

  /* 绳子 line: 顶部 fixed, 不滚动 */
  .rope-line {
    position: absolute;
    top: 16px;
    left: -2%;
    width: 104%;
    height: 36px;
    color: #6e5028;
    opacity: 0.6;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
  }

  /* track: 横向滚动 */
  .rope-track {
    position: absolute;
    inset: 0;
    overflow-x: auto;
    overflow-y: visible;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 38px 0 1rem;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(110, 80, 40, 0.25) transparent;
  }
  .rope-track::-webkit-scrollbar { height: 6px; }
  .rope-track::-webkit-scrollbar-track { background: transparent; }
  .rope-track::-webkit-scrollbar-thumb {
    background: rgba(110, 80, 40, 0.22);
    border-radius: 3px;
  }
  .rope-track::-webkit-scrollbar-thumb:hover {
    background: rgba(110, 80, 40, 0.4);
  }

  /* track 两端 spacer 让首尾不顶到边缘 */
  .rope-spacer-start, .rope-spacer-end {
    flex-shrink: 0;
    width: 2.5rem;
    height: 1px;
  }

  /* ─── 物件基础 ──────────────────────────────────── */
  .hcard {
    flex-shrink: 0;
    position: relative;
    transform: translateY(var(--y, 0)) rotate(var(--rotate, 0deg));
    transform-origin: top center;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 4px 9px rgba(80, 50, 20, 0.1),
      0 14px 26px rgba(80, 50, 20, 0.12);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                z-index 0s linear 0.35s;
    opacity: 0;
    animation: hcard-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0s) forwards;
    z-index: 2;
  }
  @keyframes hcard-in {
    0% { opacity: 0; transform: translateY(calc(var(--y, 0) - 10px)) rotate(var(--rotate, 0deg)); }
    100% { opacity: 1; transform: translateY(var(--y, 0)) rotate(var(--rotate, 0deg)); }
  }

  /* ─── 真画板卡 ───────────────────────────────────── */
  .hcard-real {
    color: #2d2418;
    text-decoration: none !important;
    background: #fbf6e6;
    background-image:
      radial-gradient(circle at 13% 27%, rgba(160, 130, 80, 0.05) 0.5px, transparent 1px),
      radial-gradient(circle at 73% 81%, rgba(160, 130, 80, 0.04) 0.5px, transparent 1px),
