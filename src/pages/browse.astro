---
import Layout from '../components/Layout.astro';
import { getAllBoards } from '../lib/boards.js';

const boards = getAllBoards();
const total = boards.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

function hash(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = ((h << 5) - h) + s.charCodeAt(i);
    h |= 0;
  }
  return Math.abs(h);
}

// 6 根绳子,每根 4 个物件 = 24 件,真画板 ~6 + 装饰 ~18
const ROPES = 6;
const ITEMS_PER_ROPE = 4;
const TOTAL = ROPES * ITEMS_PER_ROPE;

// 真画板均匀分布到 slots
const realSlots = new Set();
for (let i = 0; i < boards.length; i++) {
  let target = Math.floor(((i + 0.5) / boards.length) * TOTAL);
  while (realSlots.has(target)) target = (target + 1) % TOTAL;
  realSlots.add(target);
}

const DECO_TYPES = ['photo', 'photo', 'handwritten', 'handwritten', 'watercolor', 'collage', 'botanical', 'tag-color'];
const SHAPES = ['rect', 'rect', 'rect', 'tag', 'note'];
// binder clip 主导(就像参考图)
const CLIPS = ['binder', 'binder', 'binder', 'binder', 'wood', 'wood', 'metal', 'pin'];

// X 范围避免边缘,5%-95%
function placeAt(ropeIdx, posInRope, h) {
  const baseX = 5 + ((posInRope + 0.5) / ITEMS_PER_ROPE) * 90;
  const baseY = 13 + ((ropeIdx + 0.5) / ROPES) * 78;
  const jitterX = ((h % 18) - 9);
  const jitterY = (((h >> 4) % 8) - 4);
  return {
    x: baseX + jitterX,
    y: baseY + jitterY,
    rotate: (((h >> 8) % 110) / 10 - 5.5).toFixed(2),
    clipOffset: (((h >> 5) % 36) - 18),
  };
}

const items = [];
let realIdx = 0;
for (let slot = 0; slot < TOTAL; slot++) {
  const ropeIdx = Math.floor(slot / ITEMS_PER_ROPE);
  const posInRope = slot % ITEMS_PER_ROPE;

  if (realSlots.has(slot)) {
    const board = boards[realIdx++];
    if (!board) continue;
    const sh = hash(board.slug);
    const pos = placeAt(ropeIdx, posInRope, sh);
    items.push({
      kind: 'board',
      board,
      ...pos,
      size: ['m', 'm', 'l'][(sh >> 12) % 3],
      shape: SHAPES[sh % SHAPES.length],
      clip: CLIPS[(sh >> 3) % CLIPS.length],
      slot,
    });
  } else {
    const h = hash(`deco-${slot}`);
    const pos = placeAt(ropeIdx, posInRope, h);
    items.push({
      kind: 'deco',
      decoType: DECO_TYPES[h % DECO_TYPES.length],
      seed: h,
      ...pos,
      size: ['s', 's', 's', 'm'][(h >> 14) % 4],
      clip: CLIPS[(h >> 3) % CLIPS.length],
      slot,
    });
  }
}

const ropeYs = [];
for (let r = 0; r < ROPES; r++) {
  ropeYs.push(13 + ((r + 0.5) / ROPES) * 78 - 5);
}
---
<Layout title="所有画板" noFooter>
  <div class="wall-bg"></div>

  <div class="wall-immersive">
    {/* 标题:浮在左上角 */}
    <div class="wall-title">
      <p class="page-tagline serif">每个人都是自己人生路上的灯塔</p>
      <h1>所有人的画板</h1>
      <p class="title-meta">{total} 张真实留言挂在这面墙上</p>
    </div>

    {/* 6 根绳子 */}
    {ropeYs.map((y, i) => {
      const dropAmount = 3 + (i % 3) * 0.8;
      const midSlight = 0.3 + (i % 2) * 0.4;
      return (
        <svg
          class="rope-line"
          style={`top: ${y}%`}
          viewBox="0 0 100 8"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d={`M0,2 Q30,${2 + dropAmount} 50,${2 + dropAmount - midSlight} T100,2`}
            stroke="currentColor"
            stroke-width="0.45"
            fill="none"
            stroke-linecap="round"
          />
        </svg>
      );
    })}

    {/* Items */}
    {items.map((it) => {
      const style = `top: ${it.y}%; left: ${it.x}%; --rotate: ${it.rotate}deg; --clip-offset: ${it.clipOffset}%; --enter-delay: ${it.slot * 0.03}s;`;

      if (it.kind === 'board') {
        const board = it.board;
        const firstStranger = board.to_strangers[0] || board.to_self[0] || '';
        const tagList = (board.tags || []).slice(0, 2);
        return (
          <a
            href={`${base}/boards/${board.slug}/`}
            class={`hcard hcard-real hcard-${it.shape} hcard-size-${it.size}`}
            data-theme={board.theme}
            style={style}
            aria-label={`看 ${board.name} 的画板`}
          >
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <span class="hcard-emoji" aria-hidden="true">{board.emoji}</span>
            <h3 class="hcard-name">{board.name}</h3>
            <p class="hcard-text">{firstStranger}</p>
            {tagList.length > 0 && (
              <p class="hcard-tags">{tagList.map((t) => `#${t}`).join('  ')}</p>
            )}
          </a>
        );
      }

      // --- Decorative items ---
      const dec = it.decoType;
      const seed = it.seed;
      const hue1 = seed % 360;
      const hue2 = (seed >> 8) % 360;
      const hue3 = (seed >> 16) % 360;

      if (dec === 'photo') {
        const w = it.size === 's' ? 160 : 190;
        const h = it.size === 's' ? 180 : 220;
        return (
          <div class={`hcard hcard-deco hcard-photo hcard-size-${it.size}`} style={style} aria-hidden="true">
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <div class="photo-frame">
              <img src={`https://picsum.photos/seed/bb-${seed}/${w}/${h}`} alt="" loading="lazy" />
            </div>
          </div>
        );
      }

      if (dec === 'handwritten') {
        return (
          <div class={`hcard hcard-deco hcard-handwritten hcard-size-${it.size}`} style={style} aria-hidden="true">
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <svg class="hw-lines" viewBox="0 0 100 70" preserveAspectRatio="none" aria-hidden="true">
              <path d="M8,10 Q18,7 32,9 T 58,10 T 88,9" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
              <path d="M8,18 Q15,16 28,17 T 52,18 T 80,17" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
              <path d="M8,26 Q20,24 42,26 T 78,25" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.5" stroke-linecap="round" />
              <path d="M8,34 Q22,32 48,33 T 82,34" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.55" stroke-linecap="round" />
              <path d="M8,42 Q18,40 35,41 T 65,42" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.45" stroke-linecap="round" />
              <path d="M8,50 Q15,48 28,49 T 50,49" stroke="#5a3a18" stroke-width="0.35" fill="none" opacity="0.4" stroke-linecap="round" />
            </svg>
          </div>
        );
      }

      if (dec === 'watercolor') {
        return (
          <div class={`hcard hcard-deco hcard-watercolor hcard-size-${it.size}`} style={style} aria-hidden="true">
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <svg viewBox="0 0 100 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <ellipse cx="50" cy="42" rx="38" ry="28" fill={`hsl(${hue1}, 32%, 64%)`} opacity="0.55" />
              <ellipse cx="46" cy="38" rx="30" ry="22" fill={`hsl(${hue1 + 20}, 38%, 70%)`} opacity="0.55" />
              <ellipse cx="55" cy="45" rx="22" ry="16" fill={`hsl(${hue1 - 15}, 28%, 58%)`} opacity="0.6" />
            </svg>
          </div>
        );
      }

      if (dec === 'collage') {
        return (
          <div class={`hcard hcard-deco hcard-collage hcard-size-${it.size}`} style={style} aria-hidden="true">
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <svg viewBox="0 0 100 110" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <rect x="10" y="15" width="35" height="48" fill={`hsl(${hue1}, 45%, 62%)`} opacity="0.85" />
              <circle cx="65" cy="35" r="22" fill={`hsl(${hue2}, 50%, 60%)`} opacity="0.85" />
              <rect x="40" y="58" width="35" height="32" fill={`hsl(${hue3}, 42%, 68%)`} opacity="0.85" transform="rotate(8, 57, 74)" />
              <circle cx="22" cy="80" r="12" fill={`hsl(${hue2 + 60}, 45%, 65%)`} opacity="0.75" />
            </svg>
          </div>
        );
      }

      if (dec === 'botanical') {
        return (
          <div class={`hcard hcard-deco hcard-botanical hcard-size-${it.size}`} style={style} aria-hidden="true">
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <svg viewBox="0 0 100 130" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <path d="M50,15 L50,115" stroke="#6e8254" stroke-width="0.8" opacity="0.7" />
              <ellipse cx="50" cy="35" rx="14" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(-35, 50, 35)" />
              <ellipse cx="50" cy="55" rx="13" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(35, 50, 55)" />
              <ellipse cx="50" cy="75" rx="14" ry="6" fill="#86a96a" opacity="0.85" transform="rotate(-30, 50, 75)" />
              <ellipse cx="50" cy="95" rx="12" ry="5" fill="#86a96a" opacity="0.85" transform="rotate(28, 50, 95)" />
            </svg>
          </div>
        );
      }

      if (dec === 'tag-color') {
        const fillHue = [220, 30, 150, 350][seed % 4];
        const fillSat = [40, 55, 35, 45][seed % 4];
        return (
          <div
            class={`hcard hcard-deco hcard-tag-color hcard-size-${it.size}`}
            style={`${style} --tag-bg: hsl(${fillHue}, ${fillSat}%, 38%);`}
            aria-hidden="true"
          >
            <span class={`hcard-clip hcard-clip-${it.clip}`} aria-hidden="true"></span>
            <svg viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10,15 Q22,12 38,14 T 70,13 T 90,15" stroke="rgba(255,255,255,0.6)" stroke-width="0.5" fill="none" stroke-linecap="round" />
              <path d="M10,25 Q22,22 38,24 T 70,23 T 85,25" stroke="rgba(255,255,255,0.55)" stroke-width="0.5" fill="none" stroke-linecap="round" />
              <path d="M10,35 Q22,32 38,34 T 65,33" stroke="rgba(255,255,255,0.5)" stroke-width="0.5" fill="none" stroke-linecap="round" />
              <path d="M10,45 Q20,42 35,44 T 60,45" stroke="rgba(255,255,255,0.45)" stroke-width="0.5" fill="none" stroke-linecap="round" />
            </svg>
          </div>
        );
      }

      return null;
    })}

    {/* 浮动 CTA */}
    <a href={`${base}/create/`} class="wall-cta">
      <span class="wall-cta-line">这面墙还有地方</span>
      <span class="wall-cta-main">挂一张属于你的 →</span>
    </a>
  </div>
</Layout>

<style>
  /* ─── 墙面背景 ────────────────────────────────────── */
  .wall-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: #ece4d1;
    background-image:
      radial-gradient(ellipse 100vw 80vh at 80% -10%, rgba(255, 244, 220, 0.95) 0%, transparent 55%),
      radial-gradient(ellipse 70vw 90vh at -10% 30%, rgba(225, 215, 195, 0.55) 0%, transparent 50%);
  }
  .wall-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 25%, rgba(255, 250, 235, 0.5) 32%, rgba(255, 250, 235, 0.5) 38%, transparent 45%),
      linear-gradient(115deg, transparent 55%, rgba(255, 250, 235, 0.32) 62%, transparent 70%);
    pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    .wall-bg { background: #1d1a14; background-image: none; }
  }

  /* ─── Wall 容器 ───────────────────────────────────── */
  .wall-immersive {
    position: relative;
    width: 100vw;
    height: calc(100vh - 70px);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    overflow: hidden;
  }

  /* ─── 标题 ─────────────────────────────────────── */
  .wall-title {
    position: absolute;
    top: 1.25rem;
    left: 1.75rem;
    z-index: 10;
    max-width: 26em;
    pointer-events: none;
  }
  .page-tagline {
    font-style: italic;
    color: #8a7553;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.3rem;
  }
  .wall-title h1 {
    font-size: 1.6rem;
    margin: 0 0 0.3rem;
    font-weight: 500;
    color: #3d2f18;
  }
  .title-meta {
    color: #6e5836;
    margin: 0;
    font-size: 0.8rem;
    font-family: var(--font-sans);
  }

  /* ─── 绳子 ─────────────────────────────────────── */
  .rope-line {
    position: absolute;
    left: -3%;
    width: 106%;
    height: 36px;
    color: #6e5028;
    opacity: 0.6;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
  }

  /* ─── 物件基础 ──────────────────────────────────── */
  .hcard {
    position: absolute;
    transform: translate(-50%, -50%) rotate(var(--rotate, 0deg));
    transform-origin: center top;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 4px 9px rgba(80, 50, 20, 0.1),
      0 14px 26px rgba(80, 50, 20, 0.12);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                z-index 0s linear 0.4s;
    opacity: 0;
    animation: hcard-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0s) forwards;
    z-index: 2;
  }
  @keyframes hcard-in {
    0% { opacity: 0; transform: translate(-50%, -40%) rotate(var(--rotate, 0deg)); }
    100% { opacity: 1; transform: translate(-50%, -50%) rotate(var(--rotate, 0deg)); }
  }

  /* ─── 真画板卡(可点击) ───────────────────────── */
  .hcard-real {
    color: #2d2418;
    text-decoration: none !important;
    background: #fbf6e6;
    background-image:
      radial-gradient(circle at 13% 27%, rgba(160, 130, 80, 0.05) 0.5px, transparent 1px),
      radial-gradient(circle at 73% 81%, rgba(160, 130, 80, 0.04) 0.5px, transparent 1px),
      radial-gradient(circle at 47% 56%, rgba(160, 130, 80, 0.04) 0.5px, transparent 1px);
    background-size: 16px 16px, 24px 24px, 11px 11px;
    cursor: pointer;
  }
  .hcard-real:hover {
    transform: translate(-50%, calc(-50% - 6px)) rotate(0deg);
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.05),
      0 12px 22px rgba(80, 50, 20, 0.18),
      0 24px 44px rgba(80, 50, 20, 0.2);
    z-index: 100;
    transition-delay: 0s;
  }

  /* 卡片 sizes (适用所有 hcard) */
  .hcard-size-s { width: 140px; padding: 1.2rem 0.9rem 0.9rem; }
  .hcard-size-m { width: 175px; padding: 1.45rem 1.1rem 1rem; }
  .hcard-size-l { width: 210px; padding: 1.7rem 1.3rem 1.2rem; }

  /* ─── 真画板内容 ──────────────────────────────── */
  .hcard-real .hcard-emoji {
    font-size: 1.35rem;
    display: block;
    margin-bottom: 0.4rem;
  }
  .hcard-size-s.hcard-real .hcard-emoji { font-size: 1.15rem; }
  .hcard-size-l.hcard-real .hcard-emoji { font-size: 1.55rem; }

  .hcard-real .hcard-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.55rem;
    color: #2d2418;
    line-height: 1.3;
  }
  .hcard-size-s.hcard-real .hcard-name { font-size: 0.9rem; }
  .hcard-size-l.hcard-real .hcard-name { font-size: 1.1rem; }

  .hcard-real .hcard-text {
    font-family: var(--font-hand);
    font-size: 1rem;
    line-height: 1.7;
    color: #4d381a;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hcard-size-s.hcard-real .hcard-text { font-size: 0.9rem; -webkit-line-clamp: 3; line-clamp: 3; }
  .hcard-size-l.hcard-real .hcard-text { font-size: 1.1rem; -webkit-line-clamp: 5; line-clamp: 5; }

  .hcard-real .hcard-tags {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.72rem;
    color: #8a6c3e;
    margin: 0;
    opacity: 0.85;
  }

  /* ─── 装饰物件(不可点) ─────────────────────────── */
  .hcard-deco {
    cursor: default;
    background: #fbf6e6;
  }
  .hcard-deco:hover {
    transform: translate(-50%, calc(-50% - 3px)) rotate(0deg);
    z-index: 50;
    transition-delay: 0s;
  }

  /* photo: 米白纸框 + 内嵌图 */
  .hcard-photo {
    padding: 0.6rem 0.6rem 1.2rem !important;
    background: #fbf8ec;
  }
  .photo-frame {
    width: 100%;
    overflow: hidden;
    border-radius: 1px;
  }
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  /* handwritten: 米白纸 + SVG 假笔迹 */
  .hcard-handwritten {
    padding: 0.8rem 0.7rem !important;
    background: #f7f0db;
    aspect-ratio: 3/4;
  }
  .hw-lines {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* watercolor: 纸 + SVG 水彩色块 */
  .hcard-watercolor {
    padding: 0.7rem !important;
    background: #fdf9eb;
    aspect-ratio: 5/4;
  }
  .hcard-watercolor svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* collage: 几何拼贴 */
  .hcard-collage {
    padding: 0.6rem !important;
    background: #fbf8ec;
    aspect-ratio: 4/5;
  }
  .hcard-collage svg { width: 100%; height: 100%; display: block; }

  /* botanical: 干花/植物 */
  .hcard-botanical {
    padding: 0.6rem !important;
    background: #f9f5e3;
    aspect-ratio: 3/5;
    width: 80px !important;
  }
  .hcard-botanical svg { width: 100%; height: 100%; display: block; }

  /* tag-color: 深色色块标签 */
  .hcard-tag-color {
    padding: 1rem 0.8rem !important;
    background: var(--tag-bg, #3a5070) !important;
    aspect-ratio: 5/3;
  }
  .hcard-tag-color svg { width: 100%; height: 100%; display: block; }

  /* ─── 卡片形状变体 ──────────────────────────────── */
  .hcard-tag {
    background: #efe2c1;
    border-radius: 3px 3px 6px 6px;
    padding-top: 2.4rem !important;
  }
  .hcard-tag::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    background: #ece4d1;
    border-radius: 50%;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
    z-index: 2;
  }
  .hcard-note {
    background: #f3dca3;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      -3px 6px 12px rgba(80, 55, 18, 0.13),
      -5px 16px 26px rgba(80, 55, 18, 0.14);
  }
  .hcard-note .hcard-text { color: #5d4014; }
  .hcard-note .hcard-name { color: #3d2a0a; }

  /* theme accent for real boards */
  .hcard-real[data-theme="soft"] { background-color: #f2eaf2; }
  .hcard-real[data-theme="soft"] .hcard-text { color: #4a3358; }
  .hcard-real[data-theme="soft"] .hcard-name { color: #382048; }
  .hcard-real[data-theme="quiet"] { background-color: #e6ebef; }
  .hcard-real[data-theme="quiet"] .hcard-text { color: #2d3a4a; }
  .hcard-real[data-theme="quiet"] .hcard-name { color: #1a2536; }
  .hcard-real[data-theme="mono"] { background-color: #e3ddd0; }
  .hcard-real[data-theme="mono"] .hcard-text { color: #2a2a2a; }
  .hcard-real[data-theme="mono"] .hcard-name { color: #1a1a1a; }

  /* ─── 夹子 ──────────────────────────────────────── */
  .hcard-clip {
    position: absolute;
    top: -17px;
    left: calc(50% + var(--clip-offset, 0%));
    transform: translateX(-50%);
    z-index: 3;
  }
  /* binder clip(黑色,主导) */
  .hcard-clip-binder {
    width: 18px;
    height: 13px;
    background: linear-gradient(to bottom, #2a2a2a 0%, #161616 100%);
    border-radius: 2px;
    box-shadow: 0 3px 5px rgba(0, 0, 0, 0.45);
  }
  .hcard-clip-binder::before,
  .hcard-clip-binder::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 1.8px;
    background: linear-gradient(to bottom, #d5d5d5, #888);
    top: -3px;
