---
import Layout from '../components/Layout.astro';
import { getAllBoards } from '../lib/boards.js';

const boards = getAllBoards();
const total = boards.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

function hash(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = ((h << 5) - h) + s.charCodeAt(i);
    h |= 0;
  }
  return Math.abs(h);
}

// 3 条绳子。真画板均分,再用装饰填到每条 ~5 件,铺满整屏宽度
const ROPES = 3;
const ropeItems = Array.from({ length: ROPES }, () => []);
boards.forEach((board, i) => {
  ropeItems[i % ROPES].push({ kind: 'board', board });
});

const DECO_TYPES = ['photo', 'handwritten', 'watercolor', 'botanical'];
const TARGET_PER_ROPE = 5;
let ds = 0;
for (let r = 0; r < ROPES; r++) {
  while (ropeItems[r].length < TARGET_PER_ROPE) {
    const h = hash(`deco-${r}-${ds++}`);
    ropeItems[r].push({ kind: 'deco', decoType: DECO_TYPES[h % DECO_TYPES.length], seed: h });
  }
  // deterministic 交错排列(真画板和装饰混在一起)
  ropeItems[r].sort((a, b) => {
    const ka = a.kind === 'board' ? hash(a.board.slug) : a.seed;
    const kb = b.kind === 'board' ? hash(b.board.slug) : b.seed;
    return (ka % 97) - (kb % 97);
  });
}

const CLIPS = ['binder', 'binder', 'binder', 'wood', 'wood', 'metal', 'pin'];

function itemStyleVars(item, posInRope) {
  const key = item.kind === 'board' ? item.board.slug : `deco-${item.seed}`;
  const h = hash(key);
  return {
    rotate: (((h >> 8) % 70) / 10 - 3.5).toFixed(2),
    yOffset: ((h >> 4) % 22) - 11,
    clip: CLIPS[(h >> 3) % CLIPS.length],
    clipOffset: (((h >> 5) % 28) - 14),
    variant: h % 3,
    enterDelay: posInRope * 0.06,
  };
}

const boardsJson = JSON.stringify(boards).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');

const LEVEL_LABEL = { 1: '初级 · 便签', 2: '中级 · 相框', 3: '高级 · 金框' };
---
<Layout title="所有画板" noFooter>
  <div class="wall-bg"></div>

  <div class="wall-immersive">
    <div class="wall-title">
      <p class="page-tagline serif">每个人都是自己人生路上的灯塔</p>
      <h1>所有人的画板</h1>
      <p class="title-meta">{total} 张留言挂在墙上 · 点画框展开 · 贡献越多,画框越华丽</p>
    </div>

    {ropeItems.map((rope, ropeIdx) => (
      <section class="rope-lane">
        <svg class="rope-line" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
          <path
            d={`M0,2 Q30,${3 + ropeIdx * 0.5} 50,${2.5 + ropeIdx * 0.4} T100,2`}
            stroke="currentColor"
            stroke-width="0.4"
            fill="none"
            stroke-linecap="round"
          />
        </svg>
        <div class="rope-track">
          {rope.map((it, posIdx) => {
            const s = itemStyleVars(it, posIdx);
            const vars = `--rotate: ${s.rotate}deg; --y: ${s.yOffset}px; --clip-offset: ${s.clipOffset}%; --enter-delay: ${s.enterDelay}s;`;

            if (it.kind === 'board') {
              const board = it.board;
              const level = board.level || 1;
              const firstStranger = board.to_strangers[0] || board.to_self[0] || '';
              const tagList = (board.tags || []).slice(0, 2);
              return (
                <a
                  href={`${base}/boards/${board.slug}/`}
                  class={`frame frame-l${level} frame-v${s.variant}`}
                  data-theme={board.theme}
                  data-slug={board.slug}
                  style={vars}
                  aria-label={`展开 ${board.name} 的画板`}
                >
                  <span class={`frame-clip frame-clip-${s.clip}`} aria-hidden="true"></span>
                  {level === 3 && (
                    <>
                      <span class="frame-corner tl" aria-hidden="true"></span>
                      <span class="frame-corner tr" aria-hidden="true"></span>
                      <span class="frame-corner br" aria-hidden="true"></span>
                      <span class="frame-corner bl" aria-hidden="true"></span>
                    </>
                  )}
                  <span class="frame-mat">
                    <span class="frame-window">
                      <span class="frame-emoji" aria-hidden="true">{board.emoji}</span>
                      <span class="frame-name">{board.name}</span>
                      <span class="frame-text">{firstStranger}</span>
                      {tagList.length > 0 && (
                        <span class="frame-tags">{tagList.map((t) => `#${t}`).join('  ')}</span>
                      )}
                      <span class={`frame-stars frame-stars-${level}`} aria-hidden="true">
                        {'★'.repeat(level)}
                      </span>
                    </span>
                  </span>
                </a>
              );
            }

            // ─── 装饰物件 ───
            const dec = it.decoType;
            const seed = it.seed;
            const hue1 = seed % 360;
            const decClass = `deco deco-${dec} deco-v${s.variant}`;

            if (dec === 'photo') {
              return (
                <div class={decClass} style={vars} aria-hidden="true">
                  <span class={`frame-clip frame-clip-${s.clip}`} aria-hidden="true"></span>
                  <div class="photo-frame">
                    <img src={`https://picsum.photos/seed/bb-${seed}/180/220`} alt="" loading="lazy" />
                  </div>
                </div>
              );
            }
            if (dec === 'handwritten') {
              return (
                <div class={decClass} style={vars} aria-hidden="true">
                  <span class={`frame-clip frame-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg class="hw-lines" viewBox="0 0 100 80" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M10,12 Q20,9 34,11 T 60,12 T 88,11" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.5" stroke-linecap="round" />
                    <path d="M10,22 Q18,20 30,21 T 54,22 T 82,21" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.5" stroke-linecap="round" />
                    <path d="M10,32 Q22,30 44,32 T 80,31" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.45" stroke-linecap="round" />
                    <path d="M10,42 Q20,40 38,41 T 70,42" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.45" stroke-linecap="round" />
                    <path d="M10,52 Q18,50 30,51 T 56,52" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.4" stroke-linecap="round" />
                    <path d="M10,62 Q16,60 26,61 T 46,61" stroke="#5a3a18" stroke-width="0.4" fill="none" opacity="0.35" stroke-linecap="round" />
                  </svg>
                </div>
              );
            }
            if (dec === 'watercolor') {
              return (
                <div class={decClass} style={vars} aria-hidden="true">
                  <span class={`frame-clip frame-clip-${s.clip}`} aria-hidden="true"></span>
                  <svg viewBox="0 0 100 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <ellipse cx="50" cy="42" rx="38" ry="28" fill={`hsl(${hue1}, 32%, 64%)`} opacity="0.5" />
                    <ellipse cx="46" cy="38" rx="30" ry="22" fill={`hsl(${hue1 + 20}, 38%, 70%)`} opacity="0.5" />
                    <ellipse cx="55" cy="45" rx="20" ry="15" fill={`hsl(${hue1 - 15}, 28%, 58%)`} opacity="0.55" />
                  </svg>
                </div>
              );
            }
            // botanical
            return (
              <div class={decClass} style={vars} aria-hidden="true">
                <span class={`frame-clip frame-clip-${s.clip}`} aria-hidden="true"></span>
                <svg viewBox="0 0 100 130" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                  <path d="M50,15 L50,115" stroke="#6e8254" stroke-width="0.8" opacity="0.7" />
                  <ellipse cx="50" cy="35" rx="13" ry="6" fill="#86a96a" opacity="0.8" transform="rotate(-35, 50, 35)" />
                  <ellipse cx="50" cy="55" rx="12" ry="6" fill="#86a96a" opacity="0.8" transform="rotate(35, 50, 55)" />
                  <ellipse cx="50" cy="75" rx="13" ry="6" fill="#86a96a" opacity="0.8" transform="rotate(-30, 50, 75)" />
                  <ellipse cx="50" cy="95" rx="11" ry="5" fill="#86a96a" opacity="0.8" transform="rotate(28, 50, 95)" />
                </svg>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <a href={`${base}/create/`} class="wall-cta">
      <span class="wall-cta-line">这面墙还有地方</span>
      <span class="wall-cta-main">挂一张属于你的 →</span>
    </a>
  </div>

  {/* ─── Lightbox ─── */}
  <div id="expand-overlay" hidden>
    <div class="expand-backdrop" data-close></div>
    <article class="expand-card" id="expand-card" role="dialog" aria-modal="true" aria-labelledby="expand-name">
      <button class="expand-close" data-close type="button" aria-label="关闭">✕</button>
      <div class="expand-inner" id="expand-inner"></div>
    </article>
  </div>

  <script type="application/json" id="boards-json" set:html={boardsJson} />

  <script is:inline>
    (function () {
      var boardsData = [];
      try {
        boardsData = JSON.parse(document.getElementById('boards-json').textContent);
      } catch (e) {}
      var overlay = document.getElementById('expand-overlay');
      var inner = document.getElementById('expand-inner');
      var cardEl = document.getElementById('expand-card');
      var lastFocus = null;
      var LEVEL_NAME = { 1: '初级画框', 2: '中级画框', 3: '高级画框' };

      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function renderExpanded(board) {
        var lvl = board.level || 1;
        var p = [];
        p.push('<header class="ec-head">');
        p.push('<div class="ec-emoji-wrap"><span class="ec-emoji">' + esc(board.emoji) + '</span></div>');
        p.push('<h2 class="ec-name" id="expand-name">' + esc(board.name) + '</h2>');
        p.push('<p class="ec-level">' + '★'.repeat(lvl) + ' <span>' + LEVEL_NAME[lvl] + '</span></p>');
        if (board.tags && board.tags.length) {
          p.push('<div class="ec-tags">' + board.tags.map(function (t) { return '<span class="ec-tag">#' + esc(t) + '</span>'; }).join('') + '</div>');
        }
        if (board.mood_today) {
          p.push('<p class="ec-mood"><span class="ec-mood-label">写下这块板子那天的心情</span><span class="ec-mood-value">' + esc(board.mood_today) + '</span></p>');
        }
        p.push('</header>');
        if (board.to_self && board.to_self.length) {
          p.push('<section class="ec-block"><h3 class="ec-block-head">给自己</h3>');
          board.to_self.forEach(function (t) { p.push('<blockquote class="ec-quote ec-self"><p>' + esc(t) + '</p></blockquote>'); });
          p.push('</section>');
        }
        if (board.image && board.image.src) {
          p.push('<figure class="ec-image"><img src="' + esc(board.image.src) + '" alt="' + esc(board.image.alt || '') + '" loading="lazy"/>');
          if (board.image.alt) p.push('<figcaption>' + esc(board.image.alt) + '</figcaption>');
          p.push('</figure>');
        }
        if (board.to_strangers && board.to_strangers.length) {
          p.push('<section class="ec-block"><h3 class="ec-block-head">给你 <span class="ec-block-sub">— 这个我永远不会认识, 但今天恰好走到这里的你</span></h3>');
          board.to_strangers.forEach(function (t) { p.push('<blockquote class="ec-quote ec-stranger"><p>' + esc(t) + '</p></blockquote>'); });
          p.push('</section>');
        }
        if (board.song && board.song.url) {
          p.push('<aside class="ec-song"><p class="ec-block-head">' + esc(board.name) + ' 留下的一首歌</p>');
          if (board.song.title) p.push('<p class="ec-song-title">' + esc(board.song.title) + '</p>');
          if (board.song.why) p.push('<blockquote class="ec-quote ec-stranger"><p>' + esc(board.song.why) + '</p></blockquote>');
          p.push('<p class="ec-song-link"><a href="' + esc(board.song.url) + '" target="_blank" rel="noopener nofollow">在原平台听 →</a></p></aside>');
        }
        if (board.link) {
          p.push('<p class="ec-link"><a href="' + esc(board.link) + '" target="_blank" rel="noopener nofollow">' + esc(board.link) + ' →</a></p>');
        }
        p.push('<footer class="ec-footer"><a href="/boards/' + esc(board.slug) + '/" class="ec-permalink">看完整页面 →</a></footer>');
        return p.join('');
      }

      function open(slug) {
        var board = boardsData.find(function (b) { return b.slug === slug; });
        if (!board) return;
        lastFocus = document.activeElement;
        cardEl.dataset.theme = board.theme;
        inner.innerHTML = renderExpanded(board);
        cardEl.scrollTop = 0;
        overlay.hidden = false;
        document.body.classList.add('overlay-open');
        requestAnimationFrame(function () {
          overlay.classList.add('in');
          var b = overlay.querySelector('.expand-close');
          if (b) b.focus();
        });
      }
      function close() {
        overlay.classList.remove('in');
        document.body.classList.remove('overlay-open');
        setTimeout(function () {
          overlay.hidden = true;
          inner.innerHTML = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }, 320);
      }

      document.querySelectorAll('.frame[data-slug]').forEach(function (card) {
        card.addEventListener('click', function (e) {
          e.preventDefault();
          open(card.getAttribute('data-slug'));
        });
      });
      overlay.addEventListener('click', function (e) {
        if (e.target.dataset && e.target.dataset.close !== undefined) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !overlay.hidden) close();
      });
    })();
  </script>
</Layout>

<style>
  /* ─── 墙面背景 ─── */
  .wall-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: #ece4d1;
    background-image:
      radial-gradient(ellipse 100vw 80vh at 80% -10%, rgba(255, 244, 220, 0.95) 0%, transparent 55%),
      radial-gradient(ellipse 70vw 90vh at -10% 30%, rgba(225, 215, 195, 0.55) 0%, transparent 50%);
  }
  .wall-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 25%, rgba(255, 250, 235, 0.5) 32%, rgba(255, 250, 235, 0.5) 38%, transparent 45%),
      linear-gradient(115deg, transparent 55%, rgba(255, 250, 235, 0.3) 62%, transparent 70%);
    pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    .wall-bg { background: #1d1a14; background-image: none; }
  }

  /* ─── Wall 容器: 占满 viewport,不滚动,3 行平分高度 ─── */
  .wall-immersive {
    position: relative;
    width: 100vw;
    height: calc(100vh - 70px);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 4.5rem 2vw 1.5rem;
    gap: 0.5rem;
  }

  .wall-title {
    position: absolute;
    top: 1rem;
    left: 1.75rem;
    z-index: 10;
    max-width: 34em;
    pointer-events: none;
  }
  .page-tagline {
    font-style: italic;
    color: #8a7553;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.25rem;
  }
  .wall-title h1 {
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
    font-weight: 500;
    color: #3d2f18;
  }
  .title-meta {
    color: #6e5836;
    margin: 0;
    font-size: 0.78rem;
    font-family: var(--font-sans);
  }

  /* ─── 绳子行: 平分高度, item space-around 铺满宽度 ─── */
  .rope-lane {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    align-items: flex-start;
  }
  .rope-line {
    position: absolute;
    top: 12px;
    left: -2%;
    width: 104%;
    height: 30px;
    color: #6e5028;
    opacity: 0.55;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }
  .rope-track {
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    padding-top: 26px;
    gap: 0.5rem;
  }

  /* ─── 通用 item(画框 + 装饰)定位 ─── */
  .frame, .deco {
    flex: 0 0 auto;
    position: relative;
    transform: translateY(var(--y, 0)) rotate(var(--rotate, 0deg));
    transform-origin: top center;
    opacity: 0;
    animation: item-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0s) forwards;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                z-index 0s linear 0.35s;
    z-index: 2;
  }
  @keyframes item-in {
    0% { opacity: 0; transform: translateY(calc(var(--y, 0) - 10px)) rotate(var(--rotate, 0deg)); }
    100% { opacity: 1; transform: translateY(var(--y, 0)) rotate(var(--rotate, 0deg)); }
  }

  /* ════════ 画框等级系统 ════════ */
  .frame {
    cursor: zoom-in;
    text-decoration: none !important;
    color: #2d2418;
    display: block;
    width: 168px;
  }
  .frame:hover {
    transform: translateY(calc(var(--y, 0px) - 8px)) rotate(0deg) scale(1.12);
    z-index: 100;
    transition-delay: 0s;
  }
  .frame-window {
    display: block;
    background: #fbf6e6;
    background-image:
      radial-gradient(circle at 20% 25%, rgba(160, 130, 80, 0.05) 0.5px, transparent 1px),
      radial-gradient(circle at 75% 78%, rgba(160, 130, 80, 0.04) 0.5px, transparent 1px);
    background-size: 16px 16px, 22px 22px;
    padding: 1rem 0.9rem 0.85rem;
  }
  .frame-emoji { font-size: 1.3rem; display: block; margin-bottom: 0.35rem; }
  .frame-name {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 500;
    display: block;
    margin-bottom: 0.5rem;
    color: #2d2418;
    line-height: 1.3;
  }
  .frame-text {
    font-family: var(--font-hand);
    font-size: 1rem;
    line-height: 1.65;
    color: #4d381a;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.45rem;
  }
  .frame-tags {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.7rem;
    color: #8a6c3e;
    display: block;
    opacity: 0.8;
  }
  .frame-stars {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .frame-stars-1 { color: #b0a080; }
  .frame-stars-2 { color: #9a7338; }
  .frame-stars-3 { color: #c9962f; text-shadow: 0 0 4px rgba(201, 150, 47, 0.5); }

  /* ─ Lv1 初级: 朴素纸卡 ─ */
  .frame-l1 .frame-mat { display: block; }
  .frame-l1 {
    box-shadow: 0 3px 9px rgba(80, 50, 20, 0.12), 0 10px 22px rgba(80, 50, 20, 0.1);
    border-radius: 2px;
  }
  .frame-l1.frame-v0 .frame-window { background-color: #fbf6e6; }
  .frame-l1.frame-v1 .frame-window { background-color: #f3dca3; }
  .frame-l1.frame-v1 .frame-text { color: #5d4014; }
  .frame-l1.frame-v2 .frame-window {
    background-color: #fbf8ec;
    box-shadow: inset 0 0 0 1px #d3c4a0;
  }

  /* ─ Lv2 中级: 木框 (SVG border-image) + 白卡纸 mat ─ */
  .frame-l2 {
    border: 13px solid transparent;
    border-image: url("/frames/frame-wood.svg") 16 / 13px stretch;
    background: #fdfaf0;
    box-shadow: 0 8px 20px rgba(80, 50, 20, 0.3);
  }
  .frame-l2 .frame-mat {
    display: block;
    background: #fdfaf0;
    padding: 6px;
    box-shadow: inset 0 0 7px rgba(0, 0, 0, 0.08);
  }

  /* ─ Lv3 高级: 华丽金框 (SVG border-image) + 卡纸 ─ */
  .frame-l3 {
    border: 17px solid transparent;
    border-image: url("/frames/frame-gold.svg") 22 / 17px stretch;
    background: #fdfaf0;
    box-shadow: 0 14px 34px rgba(80, 50, 10, 0.42);
  }
  .frame-l3 .frame-mat {
    display: block;
    background: #fdfaf0;
    padding: 7px;
    box-shadow: inset 0 0 10px rgba(120, 80, 20, 0.16);
  }
  /* 角花已经在金框 SVG 里画好,隐藏旧的 CSS 角花 */
  .frame-corner { display: none; }

  /* theme accent on window */
  .frame[data-theme="soft"] .frame-window { background-color: #f2eaf2; }
  .frame[data-theme="soft"] .frame-text { color: #4a3358; }
  .frame[data-theme="quiet"] .frame-window { background-color: #e6ebef; }
  .frame[data-theme="quiet"] .frame-text { color: #2d3a4a; }
  .frame[data-theme="mono"] .frame-window { background-color: #e3ddd0; }
  .frame[data-theme="mono"] .frame-text { color: #2a2a2a; }

  /* ════════ 装饰物件 ════════ */
  .deco {
    cursor: default;
    background: #fbf8ec;
    box-shadow: 0 3px 9px rgba(80, 50, 20, 0.12), 0 10px 20px rgba(80, 50, 20, 0.1);
    border-radius: 2px;
  }
  .deco:hover { transform: translateY(calc(var(--y, 0px) - 4px)) rotate(0deg) scale(1.06); z-index: 50; transition-delay: 0s; }
