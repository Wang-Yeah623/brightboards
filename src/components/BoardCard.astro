---
import { detectMedia } from '../lib/embed.js';

const { board, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const firstSelf = board.to_self?.[0] || '';
const firstStranger = board.to_strangers?.[0] || '';
const href = `${base}/boards/${board.slug}/`;
const songMedia = board.song ? detectMedia(board.song.url) : null;
---
<article class="board-card" data-theme={board.theme}>
  <div class="bc-row">
    <div class="bc-main">
      <header class="bc-head">
        <a href={href} class="bc-name">
          <span class="bc-emoji" aria-hidden="true">{board.emoji}</span>
          <span class="bc-name-text">{board.name}</span>
        </a>
        {board.tags && board.tags.length > 0 && (
          <div class="bc-tags">
            {board.tags.map((t) => <span class="bc-tag">{t}</span>)}
          </div>
        )}
      </header>

      {firstSelf && (
        <blockquote class="bc-self">
          <span class="bc-label">给自己</span>
          <p>{firstSelf}</p>
        </blockquote>
      )}

      {firstStranger && (
        <blockquote class="bc-stranger">
          <span class="bc-label">给你 (陌生人)</span>
          <p>{firstStranger}</p>
        </blockquote>
      )}
    </div>

    {board.image && (
      <a href={href} class="bc-image-wrap" aria-label={`看 ${board.name} 的完整画板`}>
        <img
          class="bc-image"
          src={board.image.src}
          alt={board.image.alt || `${board.name} 的画板配图`}
          loading="lazy"
        />
      </a>
    )}
  </div>

  {board.song && songMedia && (
    <a href={href} class="bc-song">
      <span class="bc-song-icon" aria-hidden="true">♪</span>
      <span class="bc-song-text">
        {board.song.title || `这是 ta 留下的一首歌 · ${songMedia.label}`}
      </span>
      <span class="bc-song-arrow" aria-hidden="true">→</span>
    </a>
  )}

  {!compact &&
    (board.to_self.length + board.to_strangers.length > 2 ||
      board.song ||
      board.image) && (
    <a href={href} class="bc-more">看完整画板 →</a>
  )}
</article>

<style>
  .board-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    padding: 1.5rem 1.65rem;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-soft);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s;
  }
  .board-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--accent-soft);
  }
  .bc-row {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .bc-main { flex: 1; min-width: 0; }
  .bc-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.95rem;
  }
  .bc-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    letter-spacing: -0.005em;
  }
  .bc-name:hover { color: var(--accent); text-decoration: none; }
  .bc-emoji { font-size: 1.45rem; }
  .bc-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .bc-tag {
    background: var(--accent-bg);
    color: var(--accent);
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  blockquote {
    margin: 0.75rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent-soft);
  }
  blockquote p {
    margin: 0.25rem 0 0;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .bc-label {
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .bc-self p { color: var(--fg); }
  .bc-stranger { border-left-color: var(--accent); }
  .bc-stranger p { color: var(--accent); font-weight: 500; }

  .bc-image-wrap {
    flex: 0 0 88px;
    width: 88px;
    height: 88px;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--card-border);
    background: var(--bg-alt);
    align-self: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bc-image-wrap:hover { transform: scale(1.04); }
  .bc-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 520px) {
    .bc-image-wrap { flex-basis: 64px; width: 64px; height: 64px; }
  }

  .bc-song {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.95rem;
    padding: 0.6rem 0.9rem;
    background: var(--accent-bg);
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--accent) !important;
    font-weight: 500;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .bc-song:hover {
    background: color-mix(in srgb, var(--accent-bg) 60%, var(--accent));
    color: white !important;
    text-decoration: none;
    transform: translateX(2px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .bc-song-icon { font-size: 1.15rem; line-height: 1; }
  .bc-song-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bc-song-arrow { opacity: 0.6; }

  .bc-more {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 0.2s, transform 0.2s;
  }
  .bc-more:hover {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
